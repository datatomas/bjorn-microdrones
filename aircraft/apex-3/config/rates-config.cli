# Proposed Apex 3 pitch-rate adjustment for rate profile 0.
# In ACTUAL rates, lower pitch center sensitivity and maximum rotation rate.
# Source: 3312aee rates-config.cli; explicit pitch_expo = 20 restored from
# 7a7d64c throttle-pitch-response.cli so expo does not depend on a prior setting.
# Apply only after confirming the active profile is ACTUAL and live pitch_rc_rate > 5
# and pitch_srate > 50. This is a proposed stick-response change, not flight-tested.
rateprofile 0
set pitch_rc_rate = 5
set pitch_expo = 20
set pitch_srate = 50
save
